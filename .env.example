# KSS Studio server settings.
# On Vercel: Project -> Settings -> Environment Variables (Production + Preview).
# Locally: copy this file to .env.local (git-ignored) and run `npm run dev`.
# Leave KSS_PASSCODE empty to run browser-only (keys typed into Settings, stored in this browser).

# Required for server mode. Long and random; you type it once per device (remembered 30 days).
KSS_PASSCODE=
# Optional. Changing it signs every device out.
KSS_SESSION_SECRET=

# Claude (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Meta Graph API. Use a System User token (Business Settings -> System users) so it does not expire.
META_TOKEN=

# Cloudinary (free plan) - needed to publish to Instagram, which only accepts public image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local only: path to Chrome for the design export (api/export-png.js).
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
